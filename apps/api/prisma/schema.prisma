generator client {
  provider = "prisma-client-js"
  output   = "../src/infra/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                 @id @default(uuid())
  name                   String
  email                  String                 @unique(map: "users_email_unique")
  emailVerified          Boolean                @default(false)
  image                  String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  role                   Roles                  @default(STUDENT)
  address                String?
  addressNumber          String?
  cpfCnpj                String?
  phone                  String?
  postalCode             String?
  province               String?
  accounts               Account[]
  sessions               Session[]
  subscriptions          Subscription[]
  ratings                Rating[]
  exerciseLists          ExerciseList[]
  studyPlans             StudyPlan[]

  @@map("users")
}

model Plan {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  priceCents    Int
  description   String?
  cycle         BillingCycle   @default(MONTHLY)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  checkouts     Checkout[]

  @@map("plans")
}

model Subscription {
  id         String   @id @default(uuid())
  externalId String?
  userId     String
  planId     String
  planName   String
  startDate  DateTime
  endDate    DateTime
  metadata   Json
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       Plan     @relation(fields: [planId], references: [id])
  checkouts  Checkout[]

  @@map("subscriptions")
}

model Checkout {
  id              String   @id @default(uuid())
  checkoutSession String
  planId          String
  subscriptionId  String
  paid            Boolean  @default(false)
  createdAt       DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])

  @@map("checkouts")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Rating {
  id          String   @id @default(uuid())
  userId      String   @unique
  rating      Int
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ratings")
}

model Notification {
  id          String   @id @default(uuid())
  title       String
  content     String
  destination Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notifications")
}

model ExerciseList {
  id               String             @id @default(uuid())
  userId           String             @map("user_id")
  name             String
  shuffleQuestions Boolean            @default(false) @map("shuffle_questions")
  ignoreAnswered   Boolean            @default(false) @map("ignore_answered")
  sections         Json
  questionIds      Json               @map("question_ids")
  totalQuestions   Int                @map("total_questions")
  status           ExerciseListStatus @default(PENDING)
  correctCount     Int?               @map("correct_count")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionSubjectMap Json          @default("{}") @map("question_subject_map")
  answers          ExerciseAnswer[]

  @@index([userId])
  @@map("exercise_lists")
}

model ExerciseAnswer {
  id             String       @id @default(uuid())
  exerciseListId String       @map("exercise_list_id")
  questionId     String       @map("question_id")
  selectedAnswer Int          @map("selected_answer")
  isCorrect        Boolean?   @map("is_correct")
  timeSpentSeconds Int        @default(0) @map("time_spent_seconds")
  createdAt        DateTime   @default(now()) @map("created_at")
  exerciseList   ExerciseList @relation(fields: [exerciseListId], references: [id], onDelete: Cascade)

  @@unique([exerciseListId, questionId])
  @@index([exerciseListId])
  @@map("exercise_answers")
}

enum ExerciseListStatus {
  PENDING
  IN_PROGRESS
  FINISHED
}

enum StudyPlanStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model StudyPlan {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  name        String
  description String?
  status      StudyPlanStatus @default(ACTIVE)
  startDate   DateTime        @map("start_date")
  endDate     DateTime        @map("end_date")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals       StudyPlanGoal[]
  goalProgress StudyPlanGoalProgress[]

  @@index([userId])
  @@index([userId, status])
  @@map("study_plans")
}

model StudyPlanGoal {
  id                    String    @id @default(uuid())
  studyPlanId           String    @map("study_plan_id")
  subject               String
  weeklyQuestionsTarget Int       @map("weekly_questions_target")
  targetAccuracyPercent Int?      @map("target_accuracy_percent")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  studyPlan             StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  @@unique([studyPlanId, subject])
  @@index([studyPlanId])
  @@map("study_plan_goals")
}

model StudyPlanGoalProgress {
  id            String    @id @default(uuid())
  studyPlanId   String    @map("study_plan_id")
  goalId        String    @map("goal_id")
  subject       String
  totalAnswered Int       @default(0) @map("total_answered")
  correctCount  Int       @default(0) @map("correct_count")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  studyPlan     StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  @@unique([studyPlanId, subject])
  @@index([studyPlanId])
  @@map("study_plan_goal_progress")
}

enum BillingCycle {
  WEEKLY
  MONTHLY
  YEARLY
}

enum Roles {
  ADMIN
  STUDENT
  TEACHER
}
